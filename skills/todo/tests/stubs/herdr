#!/usr/bin/env bash
# herdr stub for work.bats: logs every call to $HERDR_LOG. Unreachable unless
# HERDR_STUB_REACHABLE=1. `agent get` succeeds for the names in
# HERDR_STUB_AGENTS. The workspace and pane of the launch are at
# $HERDR_STUB_WT. `agent start` follows HERDR_STUB_START: ok, fail, exists
# (the name is taken), term (the launcher gets SIGTERM meanwhile).
printf '%s\n' "$*" >>"$HERDR_LOG"
[[ "${HERDR_STUB_REACHABLE:-0}" == 1 ]] || exit 1
case "$1 $2" in
  "workspace list")
    jq -n --arg w "${HERDR_STUB_WT:-}" '{result: {workspaces: [{workspace_id: "w1", worktree: {checkout_path: $w}}]}}' ;;
  "agent get") [[ " ${HERDR_STUB_AGENTS:-} " == *" $3 "* ]] || exit 1; echo '{}' ;;
  "pane list") jq -n --arg w "${HERDR_STUB_WT:-}" '{result: {panes: [{pane_id: "p1", cwd: $w}]}}' ;;
  "tab create") echo '{"result":{"root_pane":{"pane_id":"p2"}}}' ;;
  "worktree open"|"pane run"|"pane wait-output"|"agent prompt") ;;
  "agent start")
    case "${HERDR_STUB_START:-ok}" in
      ok) ;;
      fail) echo "error: pane p1 is not at a shell prompt"; exit 1 ;;
      exists) echo "error: agent name $3 already exists"; exit 1 ;;
      term) kill -TERM "$PPID"; exit 1 ;;
    esac ;;
  *) echo "herdr stub: unexpected call: $*" >&2; exit 99 ;;
esac
